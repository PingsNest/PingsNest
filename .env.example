# PingsNest Server Configuration
PORT=3001

# AWS Credentials (Optional: can also be configured dynamically in UI Settings)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database & Cache Settings
# Option A: Full Connection URL (Postgres or AWS RDS)
DATABASE_URL=postgres://nova:nova_secret@localhost:5432/nova_monitor

# Option B: AWS RDS Environment Variables (Used by Elastic Beanstalk)
# RDS_HOSTNAME=pingsnest-db.c3qisey8uxdo.ap-south-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DB_NAME=postgres
# RDS_USERNAME=postgres
# RDS_PASSWORD=your_rds_password
# DB_SSL=true

# Option A: Full Redis Connection URL
REDIS_URL=redis://localhost:6379
# For AWS ElastiCache with TLS (in-transit encryption):
# REDIS_URL=rediss://your-cluster-node.xxxxxx.0001.aps1.cache.amazonaws.com:6379
# For AWS ElastiCache with TLS + AUTH token:
# REDIS_URL=rediss://:your_auth_token@your-cluster-node.xxxxxx.0001.aps1.cache.amazonaws.com:6379

# Option B: Individual Redis variables (Elastic Beanstalk properties)
# REDIS_HOST=your-cluster-node.xxxxxx.0001.aps1.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your_auth_token
# REDIS_TLS=true

# Kafka Event Bus (Optional: leave blank for direct SQL mode)
KAFKA_BROKERS=

# Security & Authentication
JWT_SECRET=nova_jwt_secret_2026_change_in_production
