# PingsNest Server Configuration
PORT=3001

# AWS Credentials (Optional: can also be configured dynamically in UI Settings)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database & Cache Settings
DATABASE_URL=postgres://nova:nova_secret@localhost:5432/nova_monitor
REDIS_URL=redis://localhost:6379

# Kafka Event Bus (Optional: leave blank for direct SQL mode)
KAFKA_BROKERS=

# Security & Authentication
JWT_SECRET=nova_jwt_secret_2026_change_in_production
