{
  "name": "api-gateway-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"vite,server\" -c \"cyan,yellow\" \"vite\" \"tsx watch server/index.ts\"",
    "dev:vite": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:html": "npm run build && node -e \"fs.cpSync('dist/assets', 'html_folder/dist-assets', {recursive: true})\"",
    "build:server": "tsc --project tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist-server/server/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.1087.0",
    "@aws-sdk/client-apigatewayv2": "^3.1087.0",
    "@aws-sdk/client-cloudwatch": "^3.1087.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1087.0",
    "@aws-sdk/client-lambda": "^3.1095.0",
    "@aws-sdk/client-ses": "^3.1103.0",
    "@aws-sdk/client-sts": "^3.1093.0",
    "@aws-sdk/client-xray": "^3.1093.0",
    "@types/compression": "^1.8.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.24.0",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
